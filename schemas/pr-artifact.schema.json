{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/schemas/pr-artifact.schema.json",
  "title": "LoopForge PR Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "pr_id",
    "patch_id",
    "issue_id",
    "title",
    "body",
    "branch_name",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "pr_id": {
      "type": "string",
      "minLength": 1
    },
    "patch_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "branch_name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["drafted", "opened", "failed", "retired"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
