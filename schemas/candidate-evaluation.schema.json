{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/schemas/candidate-evaluation.schema.json",
  "title": "LoopForge Candidate Evaluation",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "session_id", "candidate_id", "split", "status", "created_at", "evaluator_id", "cases", "objectives", "verification"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "split": {"type": "string", "enum": ["search", "control", "holdout", "combined"]},
    "status": {"type": "string", "enum": ["pass", "fail", "abstain", "error"]},
    "created_at": {"type": "string", "minLength": 1},
    "evaluator_id": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "items": {"type": "object"}},
    "objectives": {"type": "object"},
    "verification": {"type": "object"},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
