{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/schemas/harness-state.schema.json",
  "title": "LoopForge Harness State Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "state_id",
    "created_at",
    "source",
    "artifact_refs",
    "model_config_refs",
    "feature_flags",
    "experiment_ids",
    "tenant_policy_ids",
    "parent_state_ids",
    "operation_ids",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": ["runtime_manifest", "codebase_discovery", "pr_merge", "manual_import", "refinement"]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_type", "path", "confidence"],
        "properties": {
          "artifact_id": {"type": "string"},
          "artifact_type": {"type": "string"},
          "path": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "sha256": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "model_config_refs": {
      "type": "object",
      "additionalProperties": true
    },
    "feature_flags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "experiment_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tenant_policy_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "parent_state_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "operation_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
