{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/schemas/failure-diagnosis.schema.json",
  "title": "LoopForge Failure Diagnosis",
  "type": "object",
  "required": [
    "schema_version",
    "ontology_id",
    "confidence",
    "severity",
    "trace_observability",
    "evidence_trace_ids",
    "implicated_tools",
    "recommended_patch_layers",
    "root_cause_hypotheses",
    "trace_scores",
    "calibration"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "ontology_id": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "severity": {
      "type": "string"
    },
    "trace_observability": {
      "type": "string"
    },
    "evidence_trace_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "implicated_tools": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommended_patch_layers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "root_cause_hypotheses": {
      "type": "array",
      "items": {"type": "object"}
    },
    "trace_scores": {
      "type": "array",
      "items": {"type": "object"}
    },
    "expected_behavior": {
      "type": ["string", "null"]
    },
    "observed_behavior": {
      "type": ["string", "null"]
    },
    "behavior_gaps": {
      "type": "array",
      "items": {"type": "object"}
    },
    "violated_contracts": {
      "type": "array",
      "items": {"type": "object"}
    },
    "agent_flow_context": {
      "type": "object",
      "additionalProperties": true
    },
    "calibration": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
