{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/schemas/experiment-candidate.schema.json",
  "title": "LoopForge Experiment Candidate",
  "type": "object",
  "required": ["schema_version", "candidate_id", "session_id", "round_number", "parent_candidate_ids", "hypothesis", "file_updates", "patch_bundle", "status", "created_at", "proposer_id"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "candidate_id": {"type": "string"}, "session_id": {"type": "string"},
    "round_number": {"type": "integer"}, "parent_candidate_ids": {"type": "array"},
    "hypothesis": {"type": "object"}, "file_updates": {"type": "array"},
    "patch_bundle": {"type": "object"}, "status": {"type": "string"},
    "created_at": {"type": "string"}, "proposer_id": {"type": "string"},
    "metadata": {"type": "object"}
  }
}
