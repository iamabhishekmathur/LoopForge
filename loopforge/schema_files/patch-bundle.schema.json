{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/schemas/patch-bundle.schema.json",
  "title": "LoopForge Patch Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "patch_id",
    "issue_id",
    "target_artifacts",
    "diff",
    "new_eval_ids",
    "risk_assessment",
    "rollback_plan",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "patch_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "target_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "artifact_type"],
        "properties": {
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "artifact_type": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "diff": {
      "type": "string",
      "minLength": 1
    },
    "new_eval_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "risk_assessment": {
      "type": "string"
    },
    "rollback_plan": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["drafted", "gated", "rejected", "retired"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
