{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/schemas/issue-event.schema.json",
  "title": "LoopForge Issue Event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "issue_id",
    "event_type",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "candidate_created",
        "opened",
        "updated",
        "ignored",
        "resolved",
        "reopened",
        "muted",
        "reviewer_outcome"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
