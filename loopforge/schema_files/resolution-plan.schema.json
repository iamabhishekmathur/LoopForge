{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/schemas/resolution-plan.schema.json",
  "title": "LoopForge Resolution Plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "issue_id",
    "status",
    "generated_at",
    "observed_failure",
    "evidence_trace_ids",
    "contradictions",
    "root_cause_rankings",
    "recommended_next_action",
    "candidate_actions",
    "gate_blockers",
    "evidence_needed",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["drafted", "blocked", "resolved", "superseded"]
    },
    "generated_at": {
      "type": "string"
    },
    "observed_failure": {
      "type": "string"
    },
    "evidence_trace_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "root_cause_rankings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "confidence", "explanation"],
        "properties": {
          "label": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "explanation": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "recommended_next_action": {
      "type": "string"
    },
    "candidate_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "priority", "owner", "status", "action"],
        "properties": {
          "label": {"type": "string"},
          "priority": {"type": "integer"},
          "owner": {"type": "string"},
          "status": {"type": "string"},
          "action": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "gate_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "evidence_needed": {
      "type": "array",
      "items": {"type": "string"}
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
