{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/schemas/eval-example.schema.json",
  "title": "LoopForge Eval Example",
  "type": "object",
  "required": [
    "schema_version",
    "eval_id",
    "issue_id",
    "source_trace_ids",
    "primary_ontology_id",
    "ontology_version",
    "input",
    "assertions",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "eval_id": {
      "type": "string",
      "minLength": 1
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "source_trace_ids": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "primary_ontology_id": {
      "type": "string",
      "minLength": 1
    },
    "ontology_version": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "additionalProperties": true
    },
    "expected_behavior": {
      "type": "object",
      "additionalProperties": true
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string"},
          "tool": {"type": "string"},
          "claim": {"type": "string"},
          "metadata": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": ["drafted", "validated", "rejected", "accepted"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
