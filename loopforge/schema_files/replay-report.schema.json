{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/schemas/replay-report.schema.json",
  "title": "LoopForge Replay Report",
  "type": "object",
  "required": [
    "schema_version",
    "replay_id",
    "patch_id",
    "status",
    "passed_cases",
    "failed_cases",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "replay_id": {
      "type": "string",
      "minLength": 1
    },
    "patch_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "passed_cases": {
      "type": "integer",
      "minimum": 0
    },
    "failed_cases": {
      "type": "integer",
      "minimum": 0
    },
    "cases": {
      "type": "array",
      "items": {"type": "object"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
