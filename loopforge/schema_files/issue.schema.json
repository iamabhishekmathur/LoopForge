{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/schemas/issue.schema.json",
  "title": "LoopForge Issue",
  "type": "object",
  "required": [
    "schema_version",
    "issue_id",
    "title",
    "primary_ontology_id",
    "ontology_version",
    "failure_layer",
    "trace_observability",
    "severity",
    "confidence",
    "evidence_trace_ids",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "primary_ontology_id": {
      "type": "string"
    },
    "ontology_version": {
      "type": "string",
      "minLength": 1
    },
    "failure_layer": {
      "type": "string",
      "enum": ["outcome", "mechanism", "governance"]
    },
    "trace_observability": {
      "type": "string",
      "enum": ["strong", "medium", "weak", "paired_replay"]
    },
    "runtime_manifest_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "manifest_grounding_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "artifact_grounding_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "secondary_ontology_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_trace_ids": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "root_cause_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "confidence", "explanation"],
        "properties": {
          "label": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "explanation": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "recommended_patch_layers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "system_prompt",
          "developer_prompt",
          "skill",
          "tool_description",
          "tool_schema",
          "routing_policy",
          "permission_policy",
          "context_policy",
          "memory_policy",
          "observability_instrumentation",
          "harness_index",
          "agent_graph",
          "scorer",
          "eval",
          "application_code"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": ["open", "proposed", "gated", "merged", "rejected", "ignored", "reopened"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
